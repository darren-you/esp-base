menu "ESP Base"

    config ESP_BASE_PUBLIC_IP_URL
        string "URL that echoes the device's public address"
        default "https://esp.silicicsoft.com/ip"
        help
            After each broker connection the device GETs this URL once over HTTPS; the plain-text
            body is the address the server saw (normally the router's public IPv4). It is reported
            in the status document as net.public_ip, and the server estimates the device's
            location from it. Empty disables the lookup and public_ip stays null.

    config ESP_BASE_TEST_NO_BROKER
        bool "Test build only: never connect to the MQTT broker"
        default n
        help
            The firmware joins Wi-Fi but never connects to the broker, so it is never
            confirmed and the bootloader rolls back after the 300 s window. Used only to
            verify automatic rollback; release packaging refuses images built with it.

    choice ESP_BASE_TEST_BUSINESS
        prompt "Test build only: built-in business layer that misbehaves"
        default ESP_BASE_TEST_BUSINESS_NONE
        help
            Makes the base firmware (apps/esp_base) carry a business layer named test_fault that
            misbehaves on every boot. Used only to verify the business watchdog and safe mode on
            a real board; release packaging refuses images built with it.

        config ESP_BASE_TEST_BUSINESS_NONE
            bool "none"
        config ESP_BASE_TEST_BUSINESS_PANIC
            bool "abort() 20 s after boot"
        config ESP_BASE_TEST_BUSINESS_HANG
            bool "stop feeding the business watchdog 20 s after boot"
        config ESP_BASE_TEST_BUSINESS_INIT_HANG
            bool "never return from the business init callback"
    endchoice

endmenu
