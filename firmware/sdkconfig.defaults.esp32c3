# 当前 C3 实板基线：ESP32-C3 rev 0.4，4 MiB Flash，USB Serial/JTAG。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partition_table.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# C3 产品仅作为 Wi-Fi STA 与 TLS 客户端；FRP status 为本地明文 HTTP。
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
