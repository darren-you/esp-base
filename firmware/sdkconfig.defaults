# ESP Base 两个目标共用的选项；目标专属项见 sdkconfig.defaults.<target>。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 原生 A/B 回滚；应用用 RSA-3072（Secure Boot V2 方案）签名，更新时验签，不启用硬件 Secure Boot。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# 构建只产出未签名镜像，由 tools/esp_base.py sign 用仓外的键签名。
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n

# 控制任务就是主任务。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 状态文档用 uxTaskGetSystemState 报告各任务栈余量。
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# TLS 收发缓冲按需分配、用完即还。固定缓冲下每条 TLS 连接常驻约 20 KiB（收 16 KiB、发 4 KiB），系统 MQTT 和
# 业务 MQTT 两条长连接绝大部分时间空闲；ESP32-C3 上 WASM 应用运行并与固件 OTA 下载重叠时，实测历史最低堆只剩
# 25 KiB（darren-space#113 T3）。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# 状态文档上报 IPv6 地址：连上 Wi-Fi 后建链路本地地址，路由器发布前缀时按 SLAAC 生成全局地址。
# DNS 仍优先 IPv4，连接 Broker 与下载固件的路径不变。
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# 公网下载。默认接收窗口只有 4 个报文段（5,760 B）：链路好时下载被窗口限速，丢包时凑不够重复 ACK，
# 只能等对端超时重传。窗口放到 16 个报文段，接收邮箱按「窗口 / 最小常见 MSS + 余量」配，乱序队列放到上限；
# 开 SACK，让对端只重传缺的报文段。缓存的数据始终不超过窗口，约占 Wi-Fi 动态接收缓冲的一半。
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=24
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=12
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
# 经 enqueue 排队的消息（命令应答、状态文档、业务状态）要等 esp-mqtt 的任务下一轮才发出，它每轮最多等这么久：
# 默认 1000 ms 时，每条应答都晚将近 1 秒。打开自定义配置只改这一项，其余各项的默认值与不打开时相同。
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_POLL_READ_TIMEOUT_MS=100
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# WASM 宿主：WAMR 只留解释器，不要 AOT、WASI、线程和内置 libc（应用是 no_std 的 Rust）。
# 不带宿主的工程（原生业务固件）里没有这些符号，Kconfig 只提示一句未知符号，不影响构建。
CONFIG_WAMR_ENABLE_AOT=n
CONFIG_WAMR_INTERP_CLASSIC=y
CONFIG_WAMR_ENABLE_LIB_PTHREAD=n
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=n
CONFIG_WAMR_ENABLE_LIBC_WASI=n
