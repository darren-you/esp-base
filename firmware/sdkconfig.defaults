# ESP Base 两目标共用的构建选项；target 专属项见 sdkconfig.defaults.<target>。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# 签名固件观察与持久恢复由 app_main 执行，主任务栈保持 6 KiB。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# 正式受管统计保留所有已停止实例的最终栈 HWM 与真实实例计数。
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=8
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_PROTOCOL_5=n
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_REPORT_DELETED_MESSAGES=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_MD5_C=y
# Keep full TLS record limits while releasing consumed receive/send buffers.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y
