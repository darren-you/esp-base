# ESP Base 两个目标共用的选项；目标专属项见 sdkconfig.defaults.<target>。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 原生 A/B 回滚；应用用 RSA-3072（Secure Boot V2 方案）签名，更新时验签，不启用硬件 Secure Boot。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# 构建只产出未签名镜像，由 tools/esp_base.py sign 用仓外的键签名。
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n

# 控制任务就是主任务。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 状态文档用 uxTaskGetSystemState 报告各任务栈余量。
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
