# ESP32-D0WD-V3 的 4 MiB 分区与 UART0 控制入口。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/esp32-partition-table.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
# 容量输出／验签与 Flash 停用 cache 时继续接收完整串口请求。
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# 与 AMPDU RX BA 窗口 6 一致，避免保留四个不用的静态 RX 缓冲。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY=y
# 使用 SDK 原生优先 IRAM／回落 DRAM 策略，保留完整固定 TLS record 缓冲。
CONFIG_MBEDTLS_IRAM_8BIT_MEM_ALLOC=y
# 实板 idle 栈 HWM 低于 1 KiB 门，增加 512 B 后重新验证。
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048
CONFIG_PARTITION_TABLE_MD5=n
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
