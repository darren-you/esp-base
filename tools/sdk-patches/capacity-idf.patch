+void multi_heap_get_capacity_stats(multi_heap_handle_t heap, multi_heap_capacity_stats_t *stats)
+{
+    memset(stats, 0, sizeof(*stats));
+    if (heap == NULL) {
+        return;
+    }
+    multi_heap_internal_lock(heap);
+    tlsf_capacity_stats_t tlsf_stats;
+    tlsf_get_capacity_stats(heap->heap_data, &tlsf_stats);
+    stats->current_free_bytes = tlsf_stats.current_free_bytes;
+    stats->minimum_free_bytes = tlsf_stats.minimum_free_bytes;
+    stats->current_largest_allocatable_bytes = tlsf_stats.current_largest_allocatable_bytes;
+    stats->minimum_largest_allocatable_bytes = tlsf_stats.minimum_largest_allocatable_bytes;
+    stats->allocator_metadata_bytes = sizeof(heap_t) + tlsf_size(heap->heap_data);
+    multi_heap_internal_unlock(heap);
+}
