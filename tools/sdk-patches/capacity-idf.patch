+void heap_caps_walk_capacity(heap_capacity_region_cb_t callback, void *user)
+{
+    _Static_assert(SOC_MEMORY_TYPE_NO_PRIOS == HEAP_CAPACITY_PRIORITIES, "capacity priorities differ");
+    heap_t *heap;
+    SLIST_FOREACH(heap, &registered_heaps, next) {
+        if (heap->heap == NULL) continue;
+        heap_capacity_region_stats_t region = {
+            .start = heap->start, .end = heap->end,
+            .available_at_heap_init = heap->capacity_available_at_heap_init,
+        };
+        memcpy(region.caps, heap->caps, sizeof(region.caps));
+        uintptr_t first = 0, last = 0;
+        if (!esp_dram_match_iram() && esp_ptr_in_diram_dram((void *)heap->start)) {
+            first = (uintptr_t)esp_ptr_diram_dram_to_iram((void *)heap->start);
+            last = (uintptr_t)esp_ptr_diram_dram_to_iram((void *)(heap->end - sizeof(uint32_t)));
+        } else if (!esp_rtc_dram_match_rtc_iram() && esp_ptr_in_rtc_dram_fast((void *)heap->start)) {
+            first = (uintptr_t)esp_ptr_rtc_dram_to_iram((void *)heap->start);
+            last = (uintptr_t)esp_ptr_rtc_dram_to_iram((void *)(heap->end - sizeof(uint32_t)));
+        }
+        if (first) {
+            region.alias_inverted = first > last;
+            region.alias_start = MIN(first, last);
+            region.alias_end = MAX(first, last) + sizeof(uint32_t);
+        }
+        multi_heap_get_capacity_stats(heap->heap, &region.allocator);
+        if (!callback(&region, user)) break;
+    }
 }
 
