+/* The highest occupied bin has one common tlsf_fit_size boundary. */
+tlsf_decl size_t capacity_largest_allocatable(control_t *control)
+{
+    if (!control->fl_bitmap) {
+        return 0;
+    }
+    const int fl = tlsf_fls(control->fl_bitmap);
+    const int sl = tlsf_fls(control->sl_bitmap[fl]);
+    const block_header_t *block = control->blocks[fl * control->sl_index_count + sl];
+    return tlsf_fit_size(control, block_size(block));
+}
+
+/* Called only after a complete allocator operation, under the caller's heap lock. */
+tlsf_decl void capacity_record(control_t *control)
+{
+    const size_t largest = capacity_largest_allocatable(control);
+    if (largest < control->minimum_largest_allocatable_bytes) {
+        control->minimum_largest_allocatable_bytes = largest;
+    }
+    if (control->current_free_bytes < control->minimum_free_bytes) {
+        control->minimum_free_bytes = control->current_free_bytes;
+    }
+}
